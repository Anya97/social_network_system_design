@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include <cloudinsight/mongodb>

Person(user, "User", "A person using the platform")
Container(clientApp, "Client Application", "Web/Mobile App", "Interface for managing subscriptions")
Container(loadBalancer, "Load Balancer", "Nginx", "Distributes requests")

System_Boundary(subscriptionsSystem, "Subscriptions System") {
    Container(subscriptionsService, "Subscriptions Service", "Go", "Handles following and unfollowing users", $tags="webApp")
    ContainerDb(subscriptionsDb, "Subscriptions Database", "MongoDB", "Stores user subscriptions (follow relationships)", $sprite="mongodb", $tags="db")
}

Container_Ext(feedSystem, "Feed System", "Go", "Generates user feeds based on subscriptions, posts, and reactions")

Rel(user, clientApp, "Uses", "HTTPS")
Rel(clientApp, loadBalancer, "Sends requests", "HTTPS")
Rel(loadBalancer, subscriptionsService, "Routes subscription-related requests", "HTTP")
Rel(subscriptionsService, subscriptionsDb, "Reads and writes follow relationships")

Rel(feedSystem, subscriptionsDb, "Reads user subscriptions for feed generation")

@enduml